---
import StatusBadge from './StatusBadge.astro';
import Tag from './Tag.astro';
import { formatDates } from '../utils/date';
import { t } from '../i18n/ui';

// 项目卡片：首页 Featured Projects 与 /projects 列表页共用，保证两处完全一致
// 文案成对提供 zh / en；未提供 en 时该字段不参与切换（保持中文）
interface Props {
	href: string;
	title: string;
	titleEn?: string;
	description: string;
	descriptionEn?: string;
	status: string;
	tags?: string[];
	date?: Date;
	cover?: string;
	class?: string;
}

const {
	href,
	title,
	titleEn,
	description,
	descriptionEn,
	status,
	tags = [],
	date,
	cover,
	class: className = '',
} = Astro.props;

const dates = date ? formatDates(date) : undefined;

const statusLabel = t('label.status');
const dateLabel = t('label.date');
---

<article
	class:list={[
		'group relative flex flex-col overflow-hidden rounded-mybo border border-mybo-line bg-mybo-surface transition-all duration-200 hover:-translate-y-0.5 hover:border-mybo-line-strong hover:shadow-[0_18px_34px_-22px_rgba(24,24,27,0.35)]',
		className,
	]}
>
	<div
		class="relative flex aspect-video w-full items-center justify-center overflow-hidden border-b border-mybo-line bg-gradient-to-br from-[#fafafa] via-[#eeeeef] to-[#e6e6e8] p-4 sm:p-6"
	>
		<div
			class="pointer-events-none absolute inset-0"
			style="background-image:linear-gradient(to right,rgba(24,24,27,0.05) 1px,transparent 1px),linear-gradient(to bottom,rgba(24,24,27,0.05) 1px,transparent 1px);background-size:20px 20px;"
		>
		</div>

		{
			cover ? (
				<img
					src={cover}
					alt={title}
					class="relative z-10 h-full w-full rounded-mybo-md object-cover"
					loading="lazy"
				/>
			) : (
				<div class="relative z-10 w-full max-w-[300px] rounded-mybo-md border border-mybo-line bg-white/94 p-3.5 font-mono text-[11px] shadow-[0_6px_16px_-10px_rgba(24,24,27,0.35)]">
					<div class="flex items-center justify-between gap-3 border-b border-mybo-surface-2 pb-2.5">
						<span
							class="truncate font-semibold tracking-[0.02em] text-mybo-fg"
							data-zh={title}
							data-en={titleEn}
						>
							{title}
						</span>
						<span class="h-1.5 w-1.5 flex-none rounded-full bg-emerald-500" />
					</div>
					<div class="space-y-1 pt-2.5 leading-[1.9] text-mybo-faint">
						<div class="flex justify-between gap-3">
							<span data-zh={statusLabel.zh} data-en={statusLabel.en}>
								{statusLabel.zh}
							</span>
							<span class="text-mybo-fg-2">{status}</span>
						</div>
						{
							dates && (
								<div class="flex justify-between gap-3">
									<span data-zh={dateLabel.zh} data-en={dateLabel.en}>
										{dateLabel.zh}
									</span>
									<span data-zh={dates.zh} data-en={dates.en}>
										{dates.zh}
									</span>
								</div>
							)
						}
					</div>
				</div>
			)
		}
	</div>

	<div class="flex flex-1 flex-col p-5 sm:p-6">
		<div>
			<StatusBadge status={status} kind="project" />
		</div>

		<h3 class="mt-3.5 text-[17.5px] font-bold tracking-[-0.02em] text-mybo-fg transition-colors duration-200 group-hover:text-mybo-muted sm:text-[19px]">
			<a href={href}>
				<span class="absolute inset-0" aria-hidden="true"></span>
				<span data-zh={title} data-en={titleEn}>{title}</span>
			</a>
		</h3>

		<p
			class="mt-2 line-clamp-2 text-[14.5px] leading-[1.65] text-mybo-muted"
			data-zh={description}
			data-en={descriptionEn}
		>
			{description}
		</p>

		{
			tags.length > 0 && (
				<div class="mt-auto flex flex-wrap gap-1.5 border-t border-mybo-surface-2 pt-4">
					{tags.map((tag) => (
						<Tag label={tag} />
					))}
				</div>
			)
		}
	</div>
</article>
