---
import StatusBadge from './StatusBadge.astro';
import Tag from './Tag.astro';
import { formatDates } from '../utils/date';
import { t } from '../i18n/ui';

interface Props {
	href: string;
	title: string;
	titleEn?: string;
	description: string;
	descriptionEn?: string;
	status: string;
	tags?: string[];
	date?: Date;
	cover?: string;
	class?: string;
}

const {
	href,
	title,
	titleEn,
	description,
	descriptionEn,
	status,
	tags = [],
	date,
	cover,
	class: className = '',
} = Astro.props;

const dates = date ? formatDates(date) : undefined;

const statusLabel = t('label.status');
const dateLabel = t('label.date');
---

<article
	class:list={[
		'group relative flex h-full flex-col overflow-hidden rounded-mybo border border-mybo-line bg-mybo-surface transition-all duration-200 hover:-translate-y-0.5 hover:border-mybo-line-strong hover:shadow-[0_18px_34px_-22px_rgba(24,24,27,0.35)]',
		className,
	]}
>
	<!-- 封面图区域：移动端 h-32，桌面端 h-40 -->
	<div
		class="relative flex h-32 w-full items-center justify-center overflow-hidden border-b border-mybo-line bg-gradient-to-br from-[#fafafa] via-[#eeeeef] to-[#e6e6e8] p-2.5 sm:h-40 sm:p-4"
	>
		<div
			class="pointer-events-none absolute inset-0"
			style="background-image:linear-gradient(to right,rgba(24,24,27,0.05) 1px,transparent 1px),linear-gradient(to bottom,rgba(24,24,27,0.05) 1px,transparent 1px);background-size:20px 20px;"
		>
		</div>

		{
			cover ? (
				<img
					src={cover}
					alt={title}
					class="relative z-10 h-full w-full rounded-mybo-md object-cover"
					loading="lazy"
				/>
			) : (
				<div class="relative z-10 w-full max-w-[180px] rounded-mybo-md border border-mybo-line bg-white/94 p-2 font-mono text-[10px] shadow-[0_6px_16px_-10px_rgba(24,24,27,0.35)] sm:max-w-[220px] sm:p-3 sm:text-[10.5px]">
					<div class="flex items-center justify-between gap-2 border-b border-mybo-surface-2 pb-1.5 sm:pb-2">
						<span
							class="truncate font-semibold tracking-[0.02em] text-mybo-fg"
							data-zh={title}
							data-en={titleEn}
						>
							{title}
						</span>
						<span class="h-1.5 w-1.5 flex-none rounded-full bg-emerald-500" />
					</div>
					<div class="space-y-0.5 pt-1.5 leading-[1.7] text-mybo-faint sm:space-y-1 sm:pt-2 sm:leading-[1.9]">
						<div class="flex justify-between gap-2">
							<span data-zh={statusLabel.zh} data-en={statusLabel.en}>
								{statusLabel.zh}
							</span>
							<span class="text-mybo-fg-2">{status}</span>
						</div>
						{
							dates && (
								<div class="flex justify-between gap-2">
									<span data-zh={dateLabel.zh} data-en={dateLabel.en}>
										{dateLabel.zh}
									</span>
									<span data-zh={dates.zh} data-en={dates.en}>
										{dates.zh}
									</span>
								</div>
							)
						}
					</div>
				</div>
			)
		}
	</div>

	<!-- 内容区：移动端 p-3.5，桌面端 p-5 -->
	<div class="flex flex-1 flex-col p-3.5 sm:p-5">
		<div>
			<StatusBadge status={status} kind="project" />
		</div>

		<h3 class="mt-2.5 text-[16px] font-bold tracking-[-0.02em] text-mybo-fg transition-colors duration-200 group-hover:text-mybo-muted sm:mt-3 sm:text-[17.5px]">
			<a href={href}>
				<span class="absolute inset-0 z-10" aria-hidden="true"></span>
				<span data-zh={title} data-en={titleEn}>{title}</span>
			</a>
		</h3>

		<!-- 描述：移动端保持 3 行，字号稍微收紧 -->
		<p
			class="mt-1.5 line-clamp-3 text-[13px] leading-[1.6] text-mybo-muted sm:mt-2 sm:text-[13.5px] sm:leading-[1.7]"
			data-zh={description}
			data-en={descriptionEn}
		>
			{description}
		</p>

		{
			tags.length > 0 && (
				<div class="mt-auto flex flex-wrap gap-1.5 border-t border-mybo-surface-2 pt-3 sm:pt-4">
					{tags.map((tag) => (
						<Tag label={tag} />
					))}
				</div>
			)
		}
	</div>
</article>