---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ExperimentItem from '../components/ExperimentItem.astro';
import NoteItem from '../components/NoteItem.astro';
import Tag from '../components/Tag.astro';
import { projectsEn, experimentsEn, notesEn } from '../i18n/content-en';
import { t } from '../i18n/ui';

const projects = await getCollection('projects');
const experiments = await getCollection('experiments');
const notes = await getCollection('notes');

// 首页「项目与系统」：取精选项目，按日期倒序，最多展示 3 个（更多内容交给 /projects 列表页）
const featuredProjects = projects
	.filter((project) => project.data.featured)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const latestExperiments = [...experiments]
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const latestNotes = [...notes]
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const nowBuildingTags = ['AI', 'Workflow', 'Agent', 'Automation'];

const viewAll = t('action.viewAll');
---

<Layout>
	<!-- HERO -->
	<section class="shell pt-10 pb-14 sm:pt-24 sm:pb-28">
		<div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
			<div class="lg:col-span-7">
				<span
					class="inline-flex items-center gap-2 rounded-full border border-mybo-line bg-mybo-surface px-3 py-1 font-mono text-[11px] font-medium tracking-[0.1em] text-mybo-muted sm:text-[11.5px]"
				>
					<span
						class="h-1.5 w-1.5 flex-none animate-pulse rounded-full bg-emerald-500"
					></span>
					PERSONAL AI LAB
				</span>

				<h1
					class="mt-5 text-[32px] font-extrabold leading-[1.1] tracking-[-0.03em] text-mybo-fg sm:mt-6 sm:text-[50px] sm:leading-[1.08] lg:text-[56px]"
					data-zh="用 AI 构建系统。"
					data-en="Build systems with AI."
				>
					用 AI 构建系统。
				</h1>
				<p
					class="mt-2 text-[19px] font-semibold leading-[1.25] tracking-[-0.02em] text-mybo-faint sm:text-[30px] sm:leading-[1.2]"
					data-zh="自动化真实世界。"
					data-en="Automate the real world."
				>
					自动化真实世界。
				</p>

				<p
					class="mt-5 max-w-xl text-[15.5px] leading-[1.75] text-mybo-muted sm:mt-6 sm:text-[17px]"
					data-zh="探索 AI、Automation、Agent 与真实工作流，把实验变成可以长期使用的系统。"
					data-en="Exploring AI, automation, agents, and real workflows — turning experiments into systems that last."
				>
					探索 AI、Automation、Agent 与真实工作流，把实验变成可以长期使用的系统。
				</p>

				<div class="mt-7 flex flex-wrap items-center gap-3 sm:mt-8">
					<a
						href="/projects"
						class="inline-flex items-center justify-center rounded-mybo-md bg-mybo-fg px-5 py-3 text-sm font-medium text-white transition-all duration-200 hover:-translate-y-px hover:bg-[#27272a] hover:shadow-[0_8px_20px_-8px_rgba(24,24,27,0.5)] active:translate-y-0 sm:px-6"
						data-zh="浏览项目"
						data-en="Explore Projects"
					>
						浏览项目
					</a>
					<a
						href="/experiments"
						class="inline-flex items-center justify-center rounded-mybo-md border border-mybo-line bg-mybo-surface px-5 py-3 text-sm font-medium text-mybo-fg-2 transition-all duration-200 hover:-translate-y-px hover:border-mybo-line-strong hover:bg-mybo-surface-2 active:translate-y-0 sm:px-6"
						data-zh="实验记录"
						data-en="Experiments"
					>
						实验记录
					</a>
				</div>
			</div>

			<div class="lg:col-span-5">
				<div
					class="relative overflow-hidden rounded-mybo border border-mybo-line bg-gradient-to-br from-white to-[#f2f2f3] p-5 shadow-[0_1px_2px_rgba(24,24,27,0.04)] sm:p-7"
				>
					<div
						class="pointer-events-none absolute inset-0"
						style="background-image:linear-gradient(to right,rgba(24,24,27,0.055) 1px,transparent 1px),linear-gradient(to bottom,rgba(24,24,27,0.055) 1px,transparent 1px);background-size:24px 24px;-webkit-mask-image:radial-gradient(120% 100% at 50% 0%,#000,transparent 78%);mask-image:radial-gradient(120% 100% at 50% 0%,#000,transparent 78%);"
					>
					</div>

					<div
						class="relative z-10 flex flex-col items-center py-4 font-mono text-[11px] sm:py-5 sm:text-[12px]"
					>
						<div class="flex w-full items-center justify-center gap-2.5 sm:gap-3">
							<div
								class="rounded-mybo-md border border-mybo-line-strong bg-mybo-surface px-4 py-2.5 font-bold text-mybo-fg shadow-[0_1px_2px_rgba(24,24,27,0.05)] transition-transform duration-200 hover:-translate-y-0.5 sm:px-5"
							>
								AI
							</div>
							<span class="text-[#c4c4c8]" aria-hidden="true">→</span>
							<div
								class="rounded-mybo-md border border-mybo-line-strong bg-mybo-surface px-4 py-2.5 font-medium text-mybo-fg-2 shadow-[0_1px_2px_rgba(24,24,27,0.05)] transition-transform duration-200 hover:-translate-y-0.5 sm:px-5"
							>
								Workflow
							</div>
						</div>

						<div class="flex items-center gap-8 py-3 sm:gap-14">
							<span class="h-6 w-px bg-mybo-line-strong"></span>
							<span class="h-6 w-px bg-mybo-line-strong"></span>
						</div>

						<div class="flex w-full items-center justify-center gap-2.5 sm:gap-3">
							<div
								class="rounded-mybo-md border border-mybo-line-strong bg-mybo-surface px-4 py-2.5 font-medium text-mybo-fg-2 shadow-[0_1px_2px_rgba(24,24,27,0.05)] transition-transform duration-200 hover:-translate-y-0.5 sm:px-5"
							>
								Agent
							</div>
							<span class="text-[#c4c4c8]" aria-hidden="true">→</span>
							<div
								class="rounded-mybo-md border border-mybo-line-strong bg-mybo-surface px-4 py-2.5 font-medium text-mybo-fg-2 shadow-[0_1px_2px_rgba(24,24,27,0.05)] transition-transform duration-200 hover:-translate-y-0.5 sm:px-5"
							>
								Automation
							</div>
						</div>

						<span
							class="my-3 h-8 w-px bg-gradient-to-b from-mybo-line-strong to-mybo-fg"
						></span>

						<div
							class="rounded-mybo-md border border-mybo-fg bg-mybo-fg px-4 py-2.5 font-bold text-white shadow-[0_6px_16px_-10px_rgba(24,24,27,0.6)] sm:px-6 sm:py-3"
						>
							Real World System
						</div>
					</div>

					<div
						class="relative z-10 mt-4 flex items-center justify-between border-t border-mybo-line pt-3 font-mono text-[10.5px] uppercase tracking-[0.1em] text-mybo-faint"
					>
						<span>System Architecture</span>
						<span>v2.0</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- NOW BUILDING -->
	<section class="border-t border-mybo-line bg-mybo-surface py-12 sm:py-14">
		<div class="shell">
			<div
				class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
			>
				<SectionHeading
					eyebrow="正在构建"
					eyebrowEn="Now building"
					title="AI 自动化系统"
					titleEn="AI Automation Systems"
				/>
				<div class="flex flex-wrap gap-2">
					{
						nowBuildingTags.map((tag) => (
							<Tag
								label={tag}
								prefix={false}
								class="border border-mybo-line bg-mybo-bg px-2.5 py-1 text-[11.5px]"
							/>
						))
					}
				</div>
			</div>
			<p
				class="mt-4 max-w-3xl text-[15.5px] leading-[1.75] text-mybo-muted sm:mt-5 sm:text-base"
				data-zh="构建与测试 Agent 和 Workflow，使其深入真实工作的商业场景与效率闭环。"
				data-en="Building and testing agents and workflows until they reach real business scenarios and close the efficiency loop."
			>
				构建与测试 Agent 和 Workflow，使其深入真实工作的商业场景与效率闭环。
			</p>
		</div>
	</section>

	<!-- FEATURED PROJECTS (桌面端 2.5D + 移动端简化版) -->
	<section id="projects" class="border-t border-mybo-line py-14 sm:py-20">
		<div class="shell">
			<SectionHeading
				eyebrow="精选项目"
				eyebrowEn="Featured projects"
				title="项目与系统"
				titleEn="Projects & Systems"
				actionHref="/projects"
				actionLabel={viewAll.zh}
				actionLabelEn={viewAll.en}
			/>

			<div class="mt-8 sm:mt-12 grid gap-10 lg:grid-cols-12 lg:gap-16 lg:items-center">
				
				<!-- 左侧：系统架构可视化 -->
				<div class="lg:col-span-5 relative pointer-events-none">
					
					<!-- ========== 移动端简化版（< lg 显示） ========== -->
					<div class="lg:hidden">
						<div class="relative overflow-hidden rounded-mybo border border-mybo-line bg-gradient-to-br from-white to-[#f2f2f3] p-5">
							<!-- 网格背景 -->
							<div
								class="pointer-events-none absolute inset-0 opacity-50"
								style="background-image:linear-gradient(to right,rgba(24,24,27,0.05) 1px,transparent 1px),linear-gradient(to bottom,rgba(24,24,27,0.05) 1px,transparent 1px);background-size:20px 20px;"
							>
							</div>

							<div class="relative z-10 flex flex-col items-center gap-4">
								<!-- AI 核心 -->
								<div class="flex items-center justify-center">
									<div class="w-16 h-16 rounded-xl bg-gradient-to-br from-blue-400 to-blue-600 flex items-center justify-center border border-blue-300 shadow-[0_0_20px_rgba(59,130,246,0.35)]">
										<span class="text-white font-extrabold text-xl tracking-widest drop-shadow-md">AI</span>
									</div>
								</div>

								<!-- 箭头 -->
								<div class="h-4 w-px bg-gradient-to-b from-blue-300 to-blue-500"></div>

								<!-- 四个节点：2x2 网格 -->
								<div class="grid grid-cols-2 gap-2.5 w-full">
									<div class="rounded-lg bg-white border border-blue-100 p-2.5 flex items-center gap-2 shadow-sm">
										<span class="text-base">🤖</span>
										<span class="font-mono text-[11px] font-semibold text-zinc-700">Agent</span>
									</div>
									<div class="rounded-lg bg-white border border-blue-100 p-2.5 flex items-center gap-2 shadow-sm">
										<span class="text-base">🔀</span>
										<span class="font-mono text-[11px] font-semibold text-zinc-700">Workflow</span>
									</div>
									<div class="rounded-lg bg-white border border-blue-100 p-2.5 flex items-center gap-2 shadow-sm">
										<span class="text-base">🗄️</span>
										<span class="font-mono text-[11px] font-semibold text-zinc-700">Data</span>
									</div>
									<div class="rounded-lg bg-white border border-blue-100 p-2.5 flex items-center gap-2 shadow-sm">
										<span class="text-base">⚙️</span>
										<span class="font-mono text-[11px] font-semibold text-zinc-700">Automation</span>
									</div>
								</div>

								<!-- 箭头 -->
								<div class="h-4 w-px bg-gradient-to-b from-blue-500 to-emerald-500"></div>

								<!-- Real World -->
								<div class="rounded-lg bg-white border border-emerald-200 px-4 py-2 flex items-center gap-2 shadow-sm">
									<span class="text-base">🌐</span>
									<span class="font-mono text-[11px] font-semibold text-zinc-700">Real World</span>
								</div>
							</div>

							<!-- 底部注解 -->
							<div class="relative z-10 mt-4 flex items-center justify-between border-t border-mybo-line pt-3 font-mono text-[10px] uppercase tracking-[0.1em] text-mybo-faint">
								<span>System Architecture</span>
								<span>v2.0</span>
							</div>
						</div>
					</div>

					<!-- ========== 桌面端 2.5D（lg 及以上显示） ========== -->
					<div class="hidden lg:block">
						<div class="relative w-full h-[460px] flex items-center justify-center" style="perspective: 1200px; transform-style: preserve-3d;">
							<div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(circle at 50% 50%, rgba(59,130,246,0.08) 0%, transparent 70%);"></div>

							<div class="relative w-full h-full max-w-[500px] max-h-[500px]" style="transform: rotateX(55deg) rotateZ(-35deg); transform-style: preserve-3d;">
								
								<svg class="absolute inset-0 w-full h-full pointer-events-none z-0" viewBox="0 0 500 500">
									<defs>
										<linearGradient id="line-grad" x1="0%" y1="0%" x2="100%" y2="0%">
											<stop offset="0%" stop-color="#93c5fd" />
											<stop offset="100%" stop-color="#3b82f6" />
										</linearGradient>
										<marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
											<path d="M 0 0 L 10 5 L 0 10 z" fill="#3b82f6" />
										</marker>
									</defs>
									<path class="connector" d="M 125 125 C 170 170, 200 200, 238 238" marker-end="url(#arrow)" />
									<path class="connector" d="M 375 125 C 330 170, 300 200, 262 238" marker-end="url(#arrow)" />
									<path class="connector" d="M 125 375 C 170 330, 200 300, 238 262" marker-end="url(#arrow)" />
									<path class="connector" d="M 375 375 C 330 330, 300 300, 262 262" marker-end="url(#arrow)" />
									<path class="connector" d="M 262 250 C 320 250, 380 250, 438 250" marker-end="url(#arrow)" />
								</svg>

								<div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-30">
									<div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-blue-400 to-blue-600 flex items-center justify-center border border-blue-300 shadow-[0_0_30px_rgba(59,130,246,0.4),0_0_60px_rgba(59,130,246,0.2)]">
										<span class="text-white font-extrabold text-3xl tracking-widest drop-shadow-md">AI</span>
									</div>
								</div>

								<div class="absolute left-[25%] top-[25%] -translate-x-1/2 -translate-y-1/2 z-20">
									<div class="w-28 rounded-xl bg-white shadow-lg border border-blue-100 p-3 flex flex-col items-center gap-1">
										<span class="text-xl">🤖</span>
										<span class="text-[12px] font-semibold text-zinc-700 tracking-wider">Agent</span>
									</div>
								</div>
								<div class="absolute left-[75%] top-[25%] -translate-x-1/2 -translate-y-1/2 z-20">
									<div class="w-28 rounded-xl bg-white shadow-lg border border-blue-100 p-3 flex flex-col items-center gap-1">
										<span class="text-xl">🔀</span>
										<span class="text-[12px] font-semibold text-zinc-700 tracking-wider">Workflow</span>
									</div>
								</div>
								<div class="absolute left-[25%] top-[75%] -translate-x-1/2 -translate-y-1/2 z-20">
									<div class="w-28 rounded-xl bg-white shadow-lg border border-blue-100 p-3 flex flex-col items-center gap-1">
										<span class="text-xl">🗄️</span>
										<span class="text-[12px] font-semibold text-zinc-700 tracking-wider">Data</span>
									</div>
								</div>
								<div class="absolute left-[75%] top-[75%] -translate-x-1/2 -translate-y-1/2 z-20">
									<div class="w-28 rounded-xl bg-white shadow-lg border border-blue-100 p-3 flex flex-col items-center gap-1">
										<span class="text-xl">⚙️</span>
										<span class="text-[12px] font-semibold text-zinc-700 tracking-wider">Automation</span>
									</div>
								</div>
								<div class="absolute left-[88%] top-1/2 -translate-x-1/2 -translate-y-1/2 z-20">
									<div class="w-32 rounded-xl bg-white shadow-lg border border-emerald-100 p-3 flex flex-col items-center gap-1">
										<span class="text-xl">🌐</span>
										<span class="text-[12px] font-semibold text-zinc-700 tracking-wider">Real World</span>
									</div>
								</div>
							</div>
						</div>
						<div class="text-center mt-4">
							<span class="font-mono text-[10px] uppercase tracking-widest text-mybo-faint">System Architecture</span>
						</div>
					</div>
				</div>

				<!-- 右侧：项目列表 -->
				<div class="lg:col-span-7">
					<div class="divide-y divide-mybo-line border-t border-b border-mybo-line">
						{featuredProjects.map((project) => {
							const titleEn = projectsEn[project.id]?.title || project.data.title;
							const descEn = projectsEn[project.id]?.description || project.data.description;
							const isActive = project.data.status === 'active';
							
							return (
								<article class="group relative flex flex-col sm:flex-row sm:items-center justify-between gap-4 py-6 transition-colors hover:bg-mybo-surface-2/50">
									<a href={`/projects/${project.id}`} class="absolute inset-0 z-10" aria-label={project.data.title}></a>
									
									<div class="flex-1 min-w-0 relative z-20 pointer-events-none">
										<div class="flex items-center gap-3 font-mono text-[11px] text-mybo-faint mb-2">
											<span class={`inline-flex items-center gap-1.5 rounded-md border px-1.5 py-0.5 font-semibold ${isActive ? 'border-emerald-200 bg-emerald-50 text-emerald-700' : 'border-blue-200 bg-blue-50 text-blue-700'}`}>
												{isActive && <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-500"></span>}
												{isActive ? '进行中' : '已完成'}
											</span>
											<span>{project.data.date.toLocaleDateString('zh-CN')}</span>
										</div>
										
										<h3 
											class="text-[17px] sm:text-[19px] font-bold tracking-tight text-mybo-fg truncate group-hover:text-mybo-muted transition-colors"
											data-zh={project.data.title}
											data-en={titleEn}
										>
											{project.data.title}
										</h3>
										
										<p 
											class="mt-1.5 line-clamp-2 text-[13.5px] leading-[1.65] text-mybo-muted"
											data-zh={project.data.description}
											data-en={descEn}
										>
											{project.data.description}
										</p>
										
										<div class="flex flex-wrap gap-1.5 mt-3">
											{project.data.tags.map((tag) => (
												<span class="rounded-md bg-mybo-surface-2 px-2 py-[3px] font-mono text-[11px] text-mybo-muted">#{tag}</span>
											))}
										</div>
									</div>
									
									<div class="hidden sm:block flex-none text-mybo-line-strong group-hover:text-mybo-fg group-hover:translate-x-1 transition-all relative z-20 pointer-events-none">
										<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
									</div>
								</article>
							);
						})}
					</div>
				</div>

			</div>
		</div>
	</section>

	<!-- EXPERIMENTS & NOTES -->
	<section class="border-t border-mybo-line bg-mybo-surface-2 py-14 sm:py-20">
		<div class="shell">
			<div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
				<div id="experiments">
					<SectionHeading
						eyebrow="实验室"
						eyebrowEn="Lab"
						title="最新实验"
						titleEn="Latest Experiments"
						actionHref="/experiments"
						actionLabel={viewAll.zh}
						actionLabelEn={viewAll.en}
					/>

					<div
						class="mt-5 divide-y divide-mybo-line border-t border-b border-mybo-line sm:mt-6"
					>
						{
							latestExperiments.map((experiment, idx) => (
								<ExperimentItem
									href={`/experiments/${experiment.id}`}
									title={experiment.data.title}
									titleEn={experimentsEn[experiment.id]?.title}
									description={experiment.data.description}
									descriptionEn={experimentsEn[experiment.id]?.description}
									status={experiment.data.status}
									tags={experiment.data.tags}
									index={idx + 1}
									date={experiment.data.date}
								/>
							))
						}
					</div>
				</div>

				<div id="notes">
					<SectionHeading
						eyebrow="记录"
						eyebrowEn="Logs"
						title="最新笔记"
						titleEn="Latest Notes"
						actionHref="/notes"
						actionLabel={viewAll.zh}
						actionLabelEn={viewAll.en}
					/>

					<div
						class="mt-5 divide-y divide-mybo-line border-t border-b border-mybo-line sm:mt-6"
					>
						{
							latestNotes.map((note, idx) => (
								<NoteItem
									href={`/notes/${note.id}`}
									title={note.data.title}
									titleEn={notesEn[note.id]?.title}
									description={note.data.description}
									descriptionEn={notesEn[note.id]?.description}
									tags={note.data.tags}
									index={idx + 1}
									date={note.data.date}
								/>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- OPERATING SYSTEM / PHILOSOPHY -->
	<section
		id="about"
		class="border-t border-mybo-line bg-mybo-surface py-16 sm:py-24"
	>
		<div class="shell text-center">
			<p
				class="eyebrow m-0"
				data-zh="MyBo 运行系统"
				data-en="MyBo operating system"
			>
				MyBo 运行系统
			</p>

			<h2
