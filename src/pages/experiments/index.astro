---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const experiments = await getCollection('experiments');
---

<Layout title="Experiments — MyBo">
	<section class="mx-auto max-w-6xl px-6 py-20">
		<p class="text-sm font-medium text-zinc-500">
			EXPERIMENTS
		</p>

		<h1 class="mt-3 text-4xl font-bold tracking-tight">
			Experiments
		</h1>

		<p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600">
			MyBo 对 AI、Automation、Agent、Workflow 和本地 AI 的持续实验。
		</p>

		<p class="mt-8 text-sm text-zinc-500">
			实验数量：{experiments.length}
		</p>

		<div class="mt-12 grid gap-6 md:grid-cols-2">
			{
				experiments.map((experiment) => (
					<article class="rounded-xl border border-zinc-200 p-6">
						<h2 class="text-xl font-semibold">
							<a
								href={`/experiments/${experiment.id}`}
								class="hover:underline"
							>
								{experiment.data.title}
							</a>
						</h2>

						<p class="mt-3 leading-7 text-zinc-600">
							{experiment.data.description}
						</p>

						<div class="mt-5 flex flex-wrap gap-2">
							{experiment.data.tags.map((tag) => (
								<span class="rounded-full bg-zinc-100 px-3 py-1 text-xs text-zinc-600">
									{tag}
								</span>
							))}
						</div>

						<p class="mt-5 text-sm text-zinc-400">
							Status: {experiment.data.status}
						</p>

						<a
							href={`/experiments/${experiment.id}`}
							class="mt-6 inline-block text-sm font-medium text-zinc-600 hover:text-zinc-900"
						>
							View Experiment →
						</a>
					</article>
				))
			}
		</div>
	</section>
</Layout>