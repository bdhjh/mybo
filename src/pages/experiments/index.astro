---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import ExperimentItem from '../../components/ExperimentItem.astro';
import { experimentsEn } from '../../i18n/content-en';
import { countLabel } from '../../utils/date';

const experiments = await getCollection('experiments');

const orderedExperiments = [...experiments].sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const meta = countLabel('experiment', experiments.length);
---

<Layout
	title="Experiments — MyBo"
	description="MyBo 对 AI、Automation、Agent、Workflow 和本地 AI 的持续实验。"
>
	<div class="shell">
		<PageHead
			eyebrow="实验"
			eyebrowEn="Experiments"
			title="实验"
			titleEn="Experiments"
			lede="MyBo 对 AI、Automation、Agent、Workflow 和本地 AI 的持续实验。"
			ledeEn="Ongoing experiments on AI, automation, agents, workflows, and local AI."
			meta={meta.zh}
			metaEn={meta.en}
		/>

		<div class="divide-y divide-mybo-line border-t border-b border-mybo-line">
			{
				orderedExperiments.map((experiment, idx) => (
					<ExperimentItem
						href={`/experiments/${experiment.id}`}
						title={experiment.data.title}
						titleEn={experimentsEn[experiment.id]?.title}
						description={experiment.data.description}
						descriptionEn={experimentsEn[experiment.id]?.description}
						status={experiment.data.status}
						tags={experiment.data.tags}
						index={idx + 1}
						date={experiment.data.date}
					/>
				))
			}
		</div>
	</div>
</Layout>
