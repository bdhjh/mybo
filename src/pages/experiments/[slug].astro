---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Tag from '../../components/Tag.astro';
import { experimentsEn } from '../../i18n/content-en';
import { formatDates } from '../../utils/date';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
	const experiments = await getCollection('experiments');

	return experiments.map((experiment) => ({
		params: {
			slug: experiment.id,
		},
		props: {
			experiment,
		},
	}));
}

const { experiment } = Astro.props;
const { Content } = await render(experiment);

const en = experimentsEn[experiment.id];
const dates = formatDates(experiment.data.date);
const back = t('action.backTo.experiments');
const crumb = t('nav.lab');
---

<Layout
	title={`${experiment.data.title} — MyBo`}
	titleEn={`${en?.title ?? experiment.data.title} — MyBo`}
	description={experiment.data.description}
>
	<div class="shell">
		<PageHead
			eyebrow="实验"
			eyebrowEn="Experiment"
			title={experiment.data.title}
			titleEn={en?.title}
			lede={experiment.data.description}
			ledeEn={en?.description}
			crumbs={[{ href: '/experiments', zh: crumb.zh, en: crumb.en }]}
		/>

		<div
			class="flex flex-wrap items-center gap-x-4 gap-y-3 border-t border-mybo-line pt-5 sm:pt-6"
		>
			<StatusBadge status={experiment.data.status} kind="experiment" />
			<span
				class="font-mono text-[11.5px] tracking-[0.06em] text-mybo-faint"
				data-zh={dates.zh}
				data-en={dates.en}
			>
				{dates.zh}
			</span>
			{
				experiment.data.tags.length > 0 && (
					<div class="flex flex-wrap gap-1.5">
						{experiment.data.tags.map((tag) => (
							<Tag label={tag} />
						))}
					</div>
				)
			}
		</div>

		<!-- 正文：中文 / 英文两个面板，切换语言时整体显隐 -->
		<article class="mt-8 border-t border-mybo-line pt-8 sm:mt-10 sm:pt-10">
			<div class="prose-mybo max-w-[760px]" data-panel="zh">
				<Content />
			</div>

			{
				en && (
					<div
						class="prose-mybo max-w-[760px]"
						lang="en"
						data-panel="en"
						hidden
						set:html={en.html}
					/>
				)
			}
		</article>

		<div class="mt-10 border-t border-mybo-line pt-8 sm:mt-14">
			<a
				href="/experiments"
				class="group inline-flex items-center gap-2 font-mono text-[12px] text-mybo-muted transition-colors duration-200 hover:text-mybo-fg"
			>
				<span class="transition-transform duration-200 group-hover:-translate-x-1">
					←
				</span>
				<span data-zh={back.zh} data-en={back.en}>{back.zh}</span>
			</a>
		</div>
	</div>
</Layout>
