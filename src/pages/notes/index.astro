---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import NoteItem from '../../components/NoteItem.astro';
import { notesEn } from '../../i18n/content-en';
import { countLabel } from '../../utils/date';

const notes = await getCollection('notes');

const orderedNotes = [...notes].sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const meta = countLabel('note', notes.length);
---

<Layout
	title="Notes — MyBo"
	description="关于 AI、自动化、项目实践和 MyBo 构建过程的思考与记录。"
>
	<div class="shell">
		<PageHead
			eyebrow="笔记"
			eyebrowEn="Notes"
			title="笔记"
			titleEn="Notes"
			lede="关于 AI、自动化、项目实践和 MyBo 构建过程的思考与记录。"
			ledeEn="Thoughts and records on AI, automation, project practice, and the making of MyBo."
			meta={meta.zh}
			metaEn={meta.en}
		/>

		<div class="divide-y divide-mybo-line border-t border-b border-mybo-line">
			{
				orderedNotes.map((note, idx) => (
					<NoteItem
						href={`/notes/${note.id}`}
						title={note.data.title}
						titleEn={notesEn[note.id]?.title}
						description={note.data.description}
						descriptionEn={notesEn[note.id]?.description}
						tags={note.data.tags}
						index={idx + 1}
						date={note.data.date}
					/>
				))
			}
		</div>
	</div>
</Layout>
