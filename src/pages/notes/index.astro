---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const notes = await getCollection('notes');
---

<Layout title="Notes — MyBo">
	<section class="mx-auto max-w-6xl px-6 py-20">
		<p class="text-sm font-medium text-zinc-500">
			NOTES
		</p>

		<h1 class="mt-3 text-4xl font-bold tracking-tight">
			Notes
		</h1>

		<p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600">
			关于 AI、自动化、项目实践和 MyBo 构建过程的思考与记录。
		</p>

		<p class="mt-8 text-sm text-zinc-500">
			笔记数量：{notes.length}
		</p>

		<div class="mt-12 grid gap-6 md:grid-cols-2">
			{
				notes.map((note) => (
					<article class="rounded-xl border border-zinc-200 p-6">
						<h2 class="text-xl font-semibold">
							<a
								href={`/notes/${note.id}`}
								class="hover:underline"
							>
								{note.data.title}
							</a>
						</h2>

						<p class="mt-3 leading-7 text-zinc-600">
							{note.data.description}
						</p>

						<div class="mt-5 flex flex-wrap gap-2">
							{note.data.tags.map((tag) => (
								<span class="rounded-full bg-zinc-100 px-3 py-1 text-xs text-zinc-600">
									{tag}
								</span>
							))}
						</div>

						<p class="mt-5 text-sm text-zinc-400">
							{note.data.date.toLocaleDateString('zh-CN')}
						</p>

						<a
							href={`/notes/${note.id}`}
							class="mt-6 inline-block text-sm font-medium text-zinc-600 hover:text-zinc-900"
						>
							Read Note →
						</a>
					</article>
				))
			}
		</div>
	</section>
</Layout>