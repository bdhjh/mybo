---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const projects = await getCollection('projects');
---

<Layout title="Projects — MyBo">
	<section class="mx-auto max-w-6xl px-6 py-20">
		<p class="text-sm font-medium text-zinc-500">PROJECTS</p>

		<h1 class="mt-3 text-4xl font-bold tracking-tight">
			Projects
		</h1>

		<p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600">
			MyBo 构建过的 AI 应用、自动化系统和真实项目。
		</p>

		<p class="mt-8 text-sm text-zinc-500">
			项目数量：{projects.length}
		</p>

		<div class="mt-12 grid gap-6 md:grid-cols-2">
			{
				projects.map((project) => (
					<article class="rounded-xl border border-zinc-200 p-6">
						<h2 class="text-xl font-semibold">
                        	<a
		                        href={`/projects/${project.id}`}
	                        	class="hover:underline"
                        	>
                        		{project.data.title}
	                        </a>
                        </h2>

						<p class="mt-3 leading-7 text-zinc-600">
							{project.data.description}
						</p>

						<div class="mt-5 flex flex-wrap gap-2">
							{project.data.tags.map((tag) => (
								<span class="rounded-full bg-zinc-100 px-3 py-1 text-xs text-zinc-600">
									{tag}
								</span>
							))}
						</div>

						<p class="mt-5 text-sm text-zinc-400">
							status: {project.data.status}
							<a
                            	href={`/projects/${project.id}`}
								class="mt-6 inline-block text-sm font-medium text-zinc-600 hover:text-zinc-900"
							>
								View Project →
							</a>
						</p>
					</article>
				))
			}
		</div>
	</section>
</Layout>