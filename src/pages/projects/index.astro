---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projectsEn } from '../../i18n/content-en';
import { countLabel } from '../../utils/date';

const projects = await getCollection('projects');

const orderedProjects = [...projects].sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const meta = countLabel('project', projects.length);
---

<Layout
	title="Projects — MyBo"
	description="MyBo 构建过的 AI 应用、自动化系统和真实项目。"
>
	<div class="shell">
		<PageHead
			eyebrow="项目"
			eyebrowEn="Projects"
			title="项目"
			titleEn="Projects"
			lede="MyBo 构建过的 AI 应用、自动化系统和真实项目。"
			ledeEn="AI applications, automation systems, and real projects built on MyBo."
			meta={meta.zh}
			metaEn={meta.en}
		/>

		<div class="grid gap-6 pb-6 md:grid-cols-2">
			{
				orderedProjects.map((project) => (
					<ProjectCard
						href={`/projects/${project.id}`}
						title={project.data.title}
						titleEn={projectsEn[project.id]?.title}
						description={project.data.description}
						descriptionEn={projectsEn[project.id]?.description}
						status={project.data.status}
						tags={project.data.tags}
						date={project.data.date}
					/>
				))
			}
		</div>
	</div>
</Layout>
