---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'MyBo — Personal AI Lab & System Hub',
	description = 'Build with AI. Automate the real world.',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>

	<body class="bg-white text-zinc-900 antialiased">
		<header class="border-b border-zinc-200">
			<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
				<a href="/" class="text-xl font-semibold tracking-tight">
					MyBo
				</a>

				<nav class="flex gap-6 text-sm text-zinc-600">
					<a href="/" class="hover:text-zinc-900">Home</a>
					<a href="/projects" class="hover:text-zinc-900">Projects</a>
					<a href="/experiments" class="hover:text-zinc-900">Experiments</a>
					<a href="/notes" class="hover:text-zinc-900">Notes</a>
					<a href="/about" class="hover:text-zinc-900">About</a>
				</nav>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="border-t border-zinc-200">
			<div class="mx-auto max-w-6xl px-6 py-8 text-sm text-zinc-500">
				© {new Date().getFullYear()} MyBo. Personal AI Lab & System Hub.
			</div>
		</footer>
	</body>
</html>